<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox prefHeight="560.0" prefWidth="620.0" spacing="16.0" styleClass="app-root"
      stylesheets="@app.css" xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="ni.uam.edu.practicabd.Controllers.CategoriaController">
    <padding>
        <Insets top="24.0" right="26.0" bottom="24.0" left="26.0"/>
    </padding>
    <children>
        <VBox spacing="4.0">
            <children>
                <Label text="Categorías" styleClass="page-title"/>
                <Label text="Organiza los productos de tu catálogo" styleClass="page-subtitle"/>
            </children>
        </VBox>
        <VBox spacing="12.0" styleClass="card">
            <children>
                <Label text="Nueva categoría" styleClass="section-title"/>
                <TextField fx:id="txtNombre" promptText="Ej. Bebidas, Alimentos..." styleClass="input"/>
                <CheckBox fx:id="chkActiva" mnemonicParsing="false" selected="true" text="Categoría activa" styleClass="active-check"/>
                <HBox spacing="10.0">
                    <children>
                        <Button fx:id="btnGuardar" mnemonicParsing="false" onAction="#guardar" text="Guardar categoría" styleClass="button-primary"/>
                        <Button mnemonicParsing="false" onAction="#cerrar" text="Cerrar" styleClass="button-quiet"/>
                    </children>
                </HBox>
            </children>
        </VBox>
        <VBox spacing="12.0" styleClass="card" VBox.vgrow="ALWAYS">
            <children>
                <Label text="Categorías registradas" styleClass="section-title"/>
                <TextField fx:id="txtDatoFiltrar" onKeyReleased="#filtarDatosCategoria" promptText="Filtrar por nombre..." styleClass="input"/>
                <TableView fx:id="tblCategorias" prefHeight="230.0" styleClass="data-table" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="colId" prefWidth="80.0" text="ID"/>
                        <TableColumn fx:id="colNombre" prefWidth="300.0" text="Nombre"/>
                        <TableColumn fx:id="colActiva" prefWidth="130.0" text="Activa"/>
                    </columns>
                </TableView>
            </children>
        </VBox>
    </children>
</VBox>
